DATABASE_URL="postgresql://postgres:password@localhost:5432/growleads"
REDIS_URL="redis://localhost:6379"
PORT=3001

# Comma-separated origins allowed by CORS (defaults to http://localhost:3000)
ALLOWED_ORIGINS="http://localhost:3000"

# Optional: log level (defaults to info)
LOG_LEVEL=info

# Optional: email alerts when a LinkedIn account goes invalid.
# Leave blank to log alerts instead of emailing them.
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

API_SECRET="change-this-to-a-random-secret"

# Optional: encrypt li_at values at rest
ENCRYPTION_KEY="32-char-random-string-here"
